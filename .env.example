# Server Settings
PORT=8080
# Log verbosity: debug, info, warn, error (default: info)
LOG_LEVEL=info

# DB Settings (usato per sviluppo locale; in Docker il DSN è costruito dal compose)
DB_DSN=root:secret@tcp(127.0.0.1:3306)/emly?parseTime=true&loc=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5
DATABASE_NAME=emly

# API Keys
API_KEY=key-one
ADMIN_KEY=admin-key-one

# Rate Limiting — App (unauthenticated: no X-API-Key / X-Admin-Key)
RL_UNAUTH_MAX_REQS=10
RL_UNAUTH_WINDOW=5m
RL_UNAUTH_MAX_FAILS=5
RL_UNAUTH_BAN_DUR=15m

# Rate Limiting — App (authenticated: X-API-Key or X-Admin-Key present)
RL_AUTH_MAX_REQS=100
RL_AUTH_WINDOW=1m
RL_AUTH_MAX_FAILS=20
RL_AUTH_BAN_DUR=5m

# Object Storage — API file bucket (bug report attachments)
# Independent from the updates bucket below: can be a different account, a
# different S3-compatible host, or a different provider entirely. If
# S3_API_FILE_ENDPOINT is left empty and S3_API_FILE_ACCOUNT_ID is set, the
# endpoint is derived as a Cloudflare R2 URL; any other provider must set
# S3_API_FILE_ENDPOINT explicitly.
USE_S3_API_FILE_STORAGE=false
S3_API_FILE_ACCESS_KEY_ID=your-access-key-id
S3_API_FILE_SECRET_ACCESS_KEY=your-secret-access-key
S3_API_FILE_BUCKET=your-api-file-bucket-name
S3_API_FILE_REGION=auto
S3_API_FILE_ENDPOINT=https://your-endpoint.example.com
S3_API_FILE_ACCOUNT_ID=your-cloudflare-account-id

# Object Storage — updates bucket (software update installers)
# Independent from the API file bucket above; same rules apply.
USE_S3_UPDATES_STORAGE=false
S3_UPDATES_ACCESS_KEY_ID=your-access-key-id
S3_UPDATES_SECRET_ACCESS_KEY=your-secret-access-key
S3_UPDATES_BUCKET=your-updates-bucket-name
S3_UPDATES_REGION=auto
S3_UPDATES_ENDPOINT=https://your-endpoint.example.com
S3_UPDATES_ACCOUNT_ID=your-cloudflare-account-id

# Software Updates
# (Manifest download links are built from the incoming request's Host/X-Forwarded-* headers, no env var needed)
# Path prefix inside the updates bucket where installer .exe files are stored
# Leave empty to store at bucket root (e.g. "updates" → bucket/updates/EMLy_Installer_1.7.0.exe)
S3_UPDATES_PREFIX=updates
# Path prefix inside the same updates bucket for the EMLy Updater's own installers
# (self-update manifest at GET /v2/updates/manifest/updater)
S3_UPDATER_PREFIX=updater

# Remote configuration (GET/admin /v2/config)
# Leave CONFIG_UPSTREAM_URL empty on the cloud/primary instance. Set it on an
# internal site mirror to make this instance replicate its published document
# from upstream instead of accepting writes (admin routes then answer 405).
CONFIG_UPSTREAM_URL=
# How often the mirror polls upstream for a new published revision.
CONFIG_UPSTREAM_INTERVAL=5m
# API key the mirror uses against upstream; defaults to this instance's own
# API_KEY when left empty.
CONFIG_UPSTREAM_API_KEY=
